{
  "name": "agentdesk-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs && tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:nowpayments:synthetic": "node scripts/payments/test-nowpayments-synthetic.mjs",
    "security": "npm run security:scan",
    "security:scan": "node scripts/deployment-security-scan.mjs",
    "env:check": "node scripts/check-deployment-env.mjs",
    "verify:deploy": "npm run lint && npm run typecheck && npm test && npm run security:scan && npm run env:check",
    "build:netlify": "npm run verify:deploy && npm run build",
    "verify:production": "node scripts/production-smoke.mjs",
    "test:auth-e2e": "playwright test tests/e2e/auth-responsive.spec.ts",
    "test:auth-e2e:local-ui": "playwright test --config=playwright.auth-ui-local.config.ts",
    "test:auth-e2e:local-live": "playwright test --config=playwright.auth-live.config.ts",
    "test:responsive:local": "playwright test --config=playwright.public-responsive.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "jszip": "^3.10.2",
    "next": "16.3.8",
    "openai": "^7.28.0",
    "parse5": "^8.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "AgentDesk AI is a Next.js customer-support platform. A business can train an AI agent, test it in the dashboard, install a chat widget on approved websites, and review saved conversations.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabibzay-ship-it/agentdesk-ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/tabibzay-ship-it/agentdesk-ai/issues"
  },
  "homepage": "https://github.com/tabibzay-ship-it/agentdesk-ai#readme"
}
