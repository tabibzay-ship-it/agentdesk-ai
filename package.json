{
  "name": "agentdesk-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs && tsx --test --test-concurrency=1 tests/*.test.ts",
    "security:scan": "node scripts/deployment-security-scan.mjs",
    "env:check": "node scripts/check-deployment-env.mjs",
    "verify:deploy": "npm run lint && npm run typecheck && npm test && npm run security:scan && npm run env:check",
    "build:netlify": "npm run verify:deploy && next build",
    "verify:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "jszip": "^3.10.2",
    "next": "16.3.8",
    "openai": "^7.28.0",
    "parse5": "^8.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
