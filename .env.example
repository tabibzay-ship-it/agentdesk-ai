NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Public UI gates only. Keep false until each provider is configured in
# Supabase and a real end-to-end callback has passed in that environment.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_FACEBOOK_AUTH_ENABLED=false

# Canonical HTTPS origin of the deployed AgentDesk app. Required for production
# installation verification outside Vercel; on Vercel the trusted system value
# VERCEL_PROJECT_PRODUCTION_URL is used when this is empty. Never include a path.
AGENTDESK_APP_ORIGIN=

# NOWPayments is disabled unless explicitly enabled. Both secrets are server-only.
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_ORIGIN=https://api.nowpayments.io
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
